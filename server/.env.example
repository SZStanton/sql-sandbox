# Copy to server/.env and fill in. NOT the repo root: the Prisma CLI runs from
# server/ and looks for .env there, so a root copy is silently ignored.

# Owner. Migrations, sandbox provisioning, reset. Full rights.
DATABASE_URL="postgresql://playground:playground@localhost:5432/sql_sandbox?schema=public"

# The app role. SELECT, INSERT, UPDATE, DELETE and DDL inside demo_* only, and
# nothing at all on public, so no visitor can reach the migration history or the
# sandbox registry. Create it once, after the first migration:
#
#   CREATE USER pg_app WITH PASSWORD 'playground';
#   GRANT CONNECT ON DATABASE sql_sandbox TO pg_app;
#
# Then per sandbox schema, which provision.ts loops for you:
#
#   GRANT USAGE, CREATE ON SCHEMA demo_1 TO pg_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA demo_1 TO pg_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA demo_1 TO pg_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA demo_1
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO pg_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA demo_1
#     GRANT USAGE, SELECT ON SEQUENCES TO pg_app;
#
# Three things people miss: ALTER DEFAULT PRIVILEGES is what covers tables added
# by later migrations, sequences need their own grant or every INSERT fails on
# the sequence rather than the table, and CREATE on the schema is what makes the
# DDL buttons work.
DATABASE_APP_URL="postgresql://pg_app:playground@localhost:5432/sql_sandbox"

# How long a sandbox can sit idle before another visitor can claim it.
SANDBOX_IDLE_MINUTES=30

# The API port. The Vite dev proxy expects 5000.
PORT=5000

# The only origin allowed to call the API.
CLIENT_URL="http://localhost:5173"
