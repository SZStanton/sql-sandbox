# Copy to .env.local and fill in. 
# Next loads .env.local automatically; the scripts in db/ load it explicitly.

# Owner. Migrations, provisioning and sandbox reset. 
# Used only by db/ scripts, never by the running app.
DATABASE_URL="postgresql://playground:playground@localhost:5432/sql_sandbox"

# The app role. SELECT, INSERT, UPDATE, DELETE and DDL inside demo_* only, and
# nothing at all on public, so no visitor can reach the sandbox registry.
DATABASE_APP_URL="postgresql://pg_app:playground@localhost:5432/sql_sandbox"

# How long a sandbox can sit idle before another visitor can claim it.
SANDBOX_IDLE_MINUTES=30
